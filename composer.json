{
    "name": "viteetgourmand/backend",
    "description": "Vite & Gourmand PHP MVC application",
    "type": "project",
    "require": {
        "php": "^8.2",
        "ext-mongodb": "^2.1",
        "ext-pdo": "*",
        "giggsey/libphonenumber-for-php": "^9.0",
        "mongodb/mongodb": "^2.1",
        "phpmailer/phpmailer": "^6.9"
    },
    "autoload": {
        "psr-4": {
            "App\\": "App/"
        },
        "files": [
            "App/Core/functions.php"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
