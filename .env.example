APP_ENV=development
# fuseau horaire de l'appli (créneaux de commande, dates affichées) ; Europe/Paris par défaut si absent
APP_TIMEZONE=Europe/Paris
# true affiche les erreurs PHP et les traces de pile : à réserver au poste de développement.
APP_DEBUG=false
# adresse du site (liens des e-mails) : celle de "php -S localhost:8000 -t public"
APP_URL=http://localhost:8000
GOOGLE_MAPS_API_KEY=

# Hébergeur affiché dans les mentions légales (à renseigner sur l'instance en ligne).
HOSTING_NAME=
HOSTING_ADDRESS=
HOSTING_WEBSITE=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=viteetgourmand
DB_USERNAME=root
DB_PASSWORD=

MONGO_CONNECTION_STRING=mongodb://vgt_app:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:27017/viteetgourmand?authSource=viteetgourmand
MONGO_DATABASE=viteetgourmand
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_USERNAME=vgt_app
MONGO_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MONGO_AUTH_SOURCE=viteetgourmand

SESSION_NAME=viteetgourmand_session
SESSION_LIFETIME=120
SESSION_SECURE=false

PASSWORD_HASH_COST=12

# Envoi des e-mails en SMTP (PHPMailer). Sans MAIL_HOST, aucun mail n'est envoyé (erreur journalisée).
# MAIL_ENCRYPTION : tls (STARTTLS, port 587), ssl (port 465) ou none (serveur local de test : Mailpit, MailHog…).
MAIL_DRIVER=smtp
MAIL_HOST=
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@viteetgourmand.local
MAIL_FROM_NAME=Vite & Gourmand
# Adresse de l'entreprise : formulaire de contact, nouvelles commandes, devis, pied des mails.
MAIL_TO_ADDRESS=contact@viteetgourmand.local